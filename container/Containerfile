FROM ubuntu:22.04

LABEL maintainer="MUSIChydro and DFHydro Development Team"
LABEL version="3.3"
LABEL description="Container with MUSIChydro and DFHydro, CMake 3.24+, PETSc from GitLab"

ENV PATH=/usr/lib/x86_64-linux-gnu/openmpi/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH
ENV LD_LIBRARY_PATH=/usr/lib/x86_64-linux-gnu/openmpi/lib:/usr/local/petsc/lib:$LD_LIBRARY_PATH
ENV PKG_CONFIG_PATH=/usr/local/petsc/lib/pkgconfig:$PKG_CONFIG_PATH

RUN echo "==== Installing system packages ====" && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        git \
        ca-certificates \
        pkg-config \
        gfortran \
        python3 \
        python3-dev \
        python3-pip \
        libopenmpi-dev \
        openmpi-bin \
        libblas-dev \
        liblapack-dev \
        libgsl-dev \
        autoconf \
        automake \
        libtool \
        wget \
        curl && \
    update-ca-certificates && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN echo "==== Verifying MPI Installation ====" && \
    which mpicc && echo "✓ mpicc found" && \
    which mpicxx && echo "✓ mpicxx found" && \
    which mpif90 && echo "✓ mpif90 found"

RUN echo "==== Installing CMake 3.24+ ====" && \
    pip3 install --upgrade pip && \
    pip3 install cmake==3.24.0 && \
    echo "✓ CMake installed" && \
    cmake --version

RUN echo "==== Configuring Git ====" && \
    git config --global http.sslVerify true && \
    git config --global http.postBuffer 524288000

RUN echo "==== Cloning PETSc from GitLab ====" && \
    rm -rf /tmp/petsc && \
    cd /tmp && \
    git clone --depth 1 --branch release https://gitlab.com/petsc/petsc.git petsc || \
    { echo "ERROR: Git clone failed"; exit 1; } && \
    cd petsc && \
    echo "✓ PETSc cloned successfully" && \
    ls -la configure | head -2

RUN echo "==== Configuring PETSc ====" && \
    cd /tmp/petsc && \
    MPICC=$(which mpicc) && \
    MPICXX=$(which mpicxx) && \
    MPIF90=$(which mpif90) && \
    echo "Using compilers:" && \
    echo "  MPICC: $MPICC" && \
    echo "  MPICXX: $MPICXX" && \
    echo "  MPIF90: $MPIF90" && \
    unset PETSC_DIR && \
    ./configure \
        --prefix=/usr/local/petsc \
        --with-cc=$MPICC \
        --with-cxx=$MPICXX \
        --with-fc=$MPIF90 \
        --with-debugging=0 \
        --with-optimization=3 \
        --with-shared-libraries=1 \
        --with-x=0 \
        --download-f2cblaslapack > /tmp/petsc_configure.log 2>&1 && \
    echo "✓ PETSc configure successful" || \
    { echo "ERROR: PETSc configure failed"; tail -50 /tmp/petsc_configure.log; exit 1; }

RUN echo "==== Building PETSc ====" && \
    cd /tmp/petsc && \
    make -j $(nproc) all > /tmp/petsc_build.log 2>&1 && \
    echo "✓ PETSc build successful" || \
    { echo "ERROR: PETSc build failed"; tail -50 /tmp/petsc_build.log; exit 1; }

RUN echo "==== Installing PETSc ====" && \
    cd /tmp/petsc && \
    make install > /tmp/petsc_install.log 2>&1 && \
    echo "✓ PETSc install successful" || \
    { echo "ERROR: PETSc install failed"; tail -50 /tmp/petsc_install.log; exit 1; }

RUN echo "==== Verifying PETSc Installation ====" && \
    ls -la /usr/local/petsc/ || { echo "ERROR: /usr/local/petsc does not exist"; exit 1; } && \
    ls -la /usr/local/petsc/lib/ || { echo "ERROR: /usr/local/petsc/lib does not exist"; exit 1; } && \
    test -f /usr/local/petsc/lib/libpetsc.so || { echo "ERROR: libpetsc.so not found"; exit 1; } && \
    echo "✓ libpetsc.so found" && \
    ls -la /usr/local/petsc/lib/pkgconfig/ || { echo "ERROR: pkgconfig dir not found"; exit 1; } && \
    cat /usr/local/petsc/lib/pkgconfig/PETSc.pc | head -10

RUN echo "==== Testing pkg-config ====" && \
    export PKG_CONFIG_PATH=/usr/local/petsc/lib/pkgconfig:$PKG_CONFIG_PATH && \
    pkg-config --list-all | grep -i petsc || { echo "ERROR: pkg-config cannot find PETSc"; exit 1; } && \
    echo "✓ pkg-config finds PETSc" && \
    pkg-config --modversion PETSc && \
    echo "✓ PETSc version OK"

RUN echo "==== Getting compiler info from PETSc ====" && \
    export PKG_CONFIG_PATH=/usr/local/petsc/lib/pkgconfig:$PKG_CONFIG_PATH && \
    echo "C compiler: $(pkg-config PETSc --variable=ccompiler)" && \
    echo "CXX compiler: $(pkg-config PETSc --variable=cxxcompiler)" && \
    echo "✓ Compiler info available"

RUN echo "==== Cleaning up PETSc source ====" && \
    rm -rf /tmp/petsc /tmp/petsc_*.log

# NOW set PETSC_DIR after PETSc is installed
ENV PETSC_DIR=/usr/local/petsc
ENV PETSC_ARCH=arch-linux-c-opt

# Set compiler flags with -fPIC for shared library compilation
ENV CFLAGS="-fPIC"
ENV CXXFLAGS="-fPIC"
ENV FFLAGS="-fPIC"

RUN echo "==== Final Verification ====" && \
    echo "PATH: $(echo $PATH | cut -d: -f1-3)..." && \
    echo "LD_LIBRARY_PATH: $LD_LIBRARY_PATH" && \
    echo "PKG_CONFIG_PATH: $PKG_CONFIG_PATH" && \
    echo "PETSC_DIR: $PETSC_DIR" && \
    echo "CXXFLAGS: $CXXFLAGS" && \
    echo "" && \
    echo "CMake version: $(cmake --version | head -1)" && \
    echo "" && \
    echo "MPI compilers:" && \
    which mpicc && which mpicxx && which mpif90 && \
    echo "" && \
    echo "PETSc:" && \
    test -d $PETSC_DIR && echo "✓ PETSC_DIR exists" || { echo "ERROR: PETSC_DIR missing"; exit 1; } && \
    test -f $PETSC_DIR/lib/libpetsc.so && echo "✓ libpetsc.so exists" || { echo "ERROR: libpetsc.so missing"; exit 1; } && \
    export PKG_CONFIG_PATH=$PKG_CONFIG_PATH && \
    pkg-config --modversion PETSc && \
    echo "" && \
    echo "✓✓✓ Container build successful ✓✓✓"

RUN mkdir -p /workspace

WORKDIR /workspace

CMD ["/bin/bash"]
